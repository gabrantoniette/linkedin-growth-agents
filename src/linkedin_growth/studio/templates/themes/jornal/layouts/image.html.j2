{% if s.slide.headline %}<h2 class="h-slide" data-fit data-min="48">{{ s.slide.headline | inline }}</h2>{% endif %}
<figure class="shot fit-{{ s.slide.fit }}{% if s.mono %} is-mono{% endif %}">
  <div class="shot-sheet" style="clip-path: {{ torn(s.seed + 5, amp=7) }}">
    {% if s.slide.frame == 'browser' and s.host %}<figcaption class="shot-address">{{ s.host }}</figcaption>{% endif %}
    <div class="shot-view"{% if s.slide.fit == 'contain' and s.image_ratio %} style="aspect-ratio: {{ s.image_ratio }}"{% endif %}>
      <img src="{{ s.image_src }}" alt="{{ s.slide.alt or '' }}" class="fit-{{ s.slide.fit }}">
      {% if s.mark %}
      <span class="mark-box" style="left: calc({{ s.mark.left }}% - 12px); top: calc({{ s.mark.top }}% - 12px); width: calc({{ s.mark.width }}% + 24px); height: calc({{ s.mark.height }}% + 24px)">{{ icons.box }}</span>
      {% if s.mark.label %}<span class="mark-label is-{{ s.mark.side }}" style="{% if s.mark.side == 'right' %}left: calc({{ s.mark.right }}% + 30px); top: {{ s.mark.top }}%{% elif s.mark.side == 'left' %}right: calc({{ 100 - s.mark.left }}% + 30px); top: {{ s.mark.top }}%{% else %}left: {{ s.mark.left }}%; top: calc({{ s.mark.bottom }}% + 22px){% endif %}">{{ s.mark.label | inline }}</span>{% endif %}
      {% endif %}
    </div>
  </div>
  <i class="tape tape-a"></i><i class="tape tape-b"></i>
</figure>
{% if s.slide.caption %}<p class="caption-text" data-fit data-min="26">{{ s.slide.caption | inline }}</p>{% endif %}
{% if s.slide.source and s.show_sources %}<p class="source"><b>{{ t.source }}</b>{{ s.slide.source }}</p>{% endif %}
