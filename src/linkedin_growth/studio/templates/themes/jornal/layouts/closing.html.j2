<h2 class="h-closing" data-fit data-min="56">{% if s.photo %}<span class="photo-room" aria-hidden="true"></span>{% endif %}{{ s.slide.headline | inline }}</h2>
{% if s.slide.question %}<p class="closing-question" data-fit data-min="30">{{ s.slide.question | inline }}</p>{% endif %}
{% if s.slide.cta %}<p class="closing-cta" style="clip-path: {{ torn(s.seed + 9, sides='lr', amp=7, n=10) }}">{{ icons.link }}<span>{{ s.slide.cta | inline }}</span></p>{% endif %}
