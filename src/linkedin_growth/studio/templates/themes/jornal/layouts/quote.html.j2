<div class="quote-wrap"><span class="quote-mark" aria-hidden="true">“</span><blockquote class="quote" data-fit data-min="40">{% if s.photo %}<span class="photo-room" aria-hidden="true"></span>{% endif %}{{ s.slide.quote | inline }}</blockquote></div>
<p class="quote-author">{{ s.slide.author }}{% if s.slide.source %}<small>{{ s.slide.source }}</small>{% endif %}</p>
