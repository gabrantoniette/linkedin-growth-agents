# Copy this file to .env and fill it in. .env is in .gitignore.

# ------------------------------------------------------------------------------
# Anthropic: required
# ------------------------------------------------------------------------------
# API key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------------------------
# LinkedIn: only required for publishing
# ------------------------------------------------------------------------------
# The walkthrough is in the README, "Connecting LinkedIn". In short:
#   1. Create an app at https://www.linkedin.com/developers/apps
#      (the app has to be associated with a LinkedIn Page; you can create one)
#   2. On the Products tab, add "Share on LinkedIn" and
#      "Sign In with LinkedIn using OpenID Connect"
#   3. Generate the token at
#      https://www.linkedin.com/developers/tools/oauth/token-generator
#      ticking the scopes: openid, profile, w_member_social
#   4. Paste the token below
#
# The token lasts 60 days. When it expires, generate another in the same place.
# Check it with: uv run linkedin connection
LINKEDIN_ACCESS_TOKEN=

# LinkedIn API version, in YYYYMM form. Only change it on a version error.
LINKEDIN_VERSION=202609

# ------------------------------------------------------------------------------
# Models: optional
# ------------------------------------------------------------------------------
# Defaults: Opus for judgement, Sonnet for volume.
# To spend less: MAIN_MODEL=claude-sonnet-5
MAIN_MODEL=claude-opus-5
FAST_MODEL=claude-sonnet-5

# Token ceiling per response. The agents write long documents and then save the
# file; if the response is cut before the save, the file is never created. The
# CLI warns when that happens, so if you see the warning, double this.
# Without streaming, avoid going much past 32000: it hits the SDK's HTTP timeout.
MAX_TOKENS=16000

# ------------------------------------------------------------------------------
# Knowledge retrieval: optional
# ------------------------------------------------------------------------------
# Which model turns text into vectors, so the agents can search the posts you
# have already written and your past writing.
#
# Anthropic has no embeddings API, so this comes from elsewhere. The default runs
# LOCALLY through FastEmbed: no extra API key, nothing to pay, and the model file
# (about 220MB) downloads the first time you run `linkedin index`.
#
# It is multilingual on purpose. The content here is pt-BR and the references are
# English; an English-only model degrades on both.
#
# If you change the model you MUST rebuild the index:
#     uv run linkedin index --recreate
# Vectors from two different models are not comparable, and mixing them returns
# nonsense instead of an error. Set the dimensions to match the new model.
EMBEDDER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDER_DIMENSIONS=384

# How close a question has to be to your corpus before the search answers at all.
# Below it, the agent is told "No documents found" instead of being handed the
# nearest post regardless. That matters for the Planner: a hit on an unrelated
# post reads as "already written" and blocks a topic you never covered.
#
# Measured, not guessed, and re-measured on a 46-post archive after the first
# value proved wrong. Tuned for RECALL on purpose: the agent reading the results
# rejects a lookalike far better than a threshold does, so a tighter gate loses
# real matches without buying accuracy. End to end, 0.26 beat 0.32 both at
# finding written topics (90% vs 85%) and at rejecting unwritten ones (93% vs
# 86%).
#
# Lower it if the Planner misses a topic you have written. Raising it is rarely
# the fix: it hides the context the agent needs to judge with.
#
# Tied to EMBEDDER_MODEL. If you change the model, re-measure this.
MIN_SIMILARITY=0.26

# ------------------------------------------------------------------------------
# Studio (carousels, images, video): optional
# ------------------------------------------------------------------------------
# The Post Designer renders in a headless Chromium. It tries Playwright's own
# build first (`uv run playwright install chromium`), then an installed Google
# Chrome, then Microsoft Edge. Set this to chrome or msedge to force one.
STUDIO_BROWSER_CHANNEL=

# ------------------------------------------------------------------------------
# Memory: optional
# ------------------------------------------------------------------------------
# Who the long-term memory belongs to. The system serves one person, but Agno
# indexes memory by user: without a fixed id nothing would be retrievable. Only
# change it if two people will share the same database, in which case each uses
# their own and one's content never appears in the other's context.
USER_ID=user

# Which conversation `linkedin chat` continues when you do not pass --session.
# It is what makes today's chat remember yesterday's.
DEFAULT_SESSION=main
