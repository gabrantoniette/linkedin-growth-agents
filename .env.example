# Copie este arquivo para .env e preencha. O .env está no .gitignore.

# ------------------------------------------------------------------------------
# Anthropic — obrigatório
# ------------------------------------------------------------------------------
# Chave da API em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------------------------
# LinkedIn — obrigatório só para publicar
# ------------------------------------------------------------------------------
# Passo a passo no README, seção "Conectar o LinkedIn". Em resumo:
#   1. Crie um app em https://www.linkedin.com/developers/apps
#      (o app precisa estar associado a uma LinkedIn Page — você pode criar uma)
#   2. Na aba Products, adicione "Share on LinkedIn" e
#      "Sign In with LinkedIn using OpenID Connect"
#   3. Gere o token em
#      https://www.linkedin.com/developers/tools/oauth/token-generator
#      marcando os escopos: openid, profile, w_member_social
#   4. Cole o token abaixo
#
# O token dura 60 dias. Quando expirar, gere outro no mesmo lugar.
# Confira a validade com: uv run linkedin conexao
LINKEDIN_ACCESS_TOKEN=

# Versão da API do LinkedIn, no formato AAAAMM. Só mude se der erro de versão.
LINKEDIN_VERSION=202608

# ------------------------------------------------------------------------------
# Modelos — opcional
# ------------------------------------------------------------------------------
# Padrões: opus para julgamento, sonnet para volume.
# Para gastar menos: MODELO_PRINCIPAL=claude-sonnet-5
MODELO_PRINCIPAL=claude-opus-5
MODELO_RAPIDO=claude-sonnet-5
