# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Environment / secrets
.env
.env.local

# Personal data: the LinkedIn export, the profile derived from it, the optional
# brand file and the photo it points to. Nothing in this folder is project code.
profile/

# What the agents produce from that data. It stays out for the same reason the
# profile does: the diagnosis, the profile copy and the strategy are one
# specific person's career analysis, not project code. It is also generated
# output that changes on every run, so versioning it would only add noise to
# the history. The folder tree is recreated by `ensure_directories()`.
content/

# The agents' session database
tmp/

# The application dossiers the agents build for a specific job posting: the
# tailored CV, the job breakdown and the gap analysis. Same reason as
# `content/`: one person's career data, regenerated on every run.
applications/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Claude Code: machine-local configuration
.claude/settings.local.json

# The headroom plugin's wrapper state. The only field that ever changes in these
# is the PID of the running session, so tracking them means every `git status`
# reports them modified, forever, and every machine conflicts over a number that
# means nothing outside the process that wrote it.
.claude/.headroom_wrap_*

# Benchmarks: ferramenta de medicao local, nao faz parte do que se publica.
# Inclui o indice e o corpus sintetico que as rodadas escrevem.
benchmarks/
